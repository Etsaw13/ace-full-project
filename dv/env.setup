#! /bin/bash

# cadence
module unload cadence/xcelium
module load cadence/xcelium/24.09.008
export XCELIUM_HOME=/ic/eda/Cadence/XCELIUM24.09.008

export FLEXLM_DIAGNOSTICS=10
export UVM_HOME=${VCS_HOME}/etc/uvm-1.2

# synopsys
module unload synopsys/verdi
module unload synopsys/vcs
module load synopsys/vcs/vT-2022.06
module load synopsys/verdi/T-2022.06

module unload synopsys/vip
#module load synopsys/vip/vip_T-2022.09
##module load synopsys/vip/vip_X-2025.06
module load synopsys/vip/vip_V-2023.12

# dump glitch
export NOVAS_FSDB_ENV_DUMP_SEQ_NUM=1
export NOVAS_FSDB_ENV_MAX_GLITCH_NUM=0
export LM_LICENSE_FILE=27001@IC3:27001@IC1:27001@IC2:27007@IC1:27006@IC1:27001@IC6
